          "en_highlights": [
            "consumption is consequence of income",
            "cannot boost"
          ],
          "relative_start": 35.0,
          "relative_end": 43.80000000000018
        },
        {
          "index": 6,
          "start": 2059.3,
          "end": 2068.7,
          "en": "But I think that view is totally incorrect, because you can definitely work on the social safety net.",
