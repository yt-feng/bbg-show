      "subtitles": [
        {
          "index": 1,
          "start": 0.0,
          "end": 3.6,
          "relative_start": 0.0,
          "relative_end": 3.6,
          "en": "There's one place in the world that can't seem to quit smoking.",
          "zh": "世界上有一个地方似乎无法戒烟。",
          "zh_highlights": [
            "无法戒烟"
          ],
          "en_highlights": [
            "quit smoking"
          ]
        },
        {
          "index": 2,
          "start": 3.6,
          "end": 9.2,
          "relative_start": 3.6,
          "relative_end": 9.2,
          "en": "Airports. Over the years, cigarettes have been forced out of public spaces.",
          "zh": "机场。多年来，香烟已被逐出公共场所。",
          "zh_highlights": [
            "机场",
            "公共场所"
          ],
          "en_highlights": [
            "Airports",
            "public spaces"
          ]
        },
        {
          "index": 3,
          "start": 9.2,
          "end": 13.4,
          "relative_start": 9.2,
          "relative_end": 13.4,
          "en": "Restaurants, bars, workplaces, even beaches.",
          "zh": "餐厅、酒吧、工作场所，甚至海滩。",
          "zh_highlights": [
            "餐厅",
            "海滩"
          ],
          "en_highlights": [
            "Restaurants",
            "beaches"
          ]
        },
        {
          "index": 4,
          "start": 13.4,
          "end": 17.8,
          "relative_start": 13.4,
          "relative_end": 17.8,
          "en": "But indoor smoking rooms are still allowed in more than 100 countries.",
          "zh": "但超过100个国家仍允许室内吸烟室。",
          "zh_highlights": [
            "室内吸烟室"
          ],
          "en_highlights": [
            "indoor smoking rooms"
          ]
        },
        {
          "index": 5,
          "start": 17.8,
          "end": 21.0,
          "relative_start": 17.8,
          "relative_end": 21.0,
          "en": "These spaces feel like relics from the past.",
          "zh": "这些空间感觉像是过去的遗物。",
          "zh_highlights": [
            "过去的遗物"
          ],
          "en_highlights": [
            "relics from the past"
          ]
        },
        {
          "index": 6,
          "start": 21.0,
          "end": 26.4,
          "relative_start": 21.0,
          "relative_end": 26.4,
          "en": "But they also function as anomalies in countries where hostility to smoking has only grown.",
          "zh": "但在对吸烟敌意日益增长的国家，它们也是异类。",
          "zh_highlights": [
            "异类"
          ],
          "en_highlights": [
            "anomalies"
          ]
        },
        {
          "index": 7,
          "start": 26.4,
          "end": 30.6,
          "relative_start": 26.4,
          "relative_end": 30.6,
          "en": "The Swiss may be banned from smoking at outdoor bus stops in Geneva.",
          "zh": "瑞士可能禁止在日内瓦户外公交站吸烟。",
          "zh_highlights": [],
          "en_highlights": [
            "banned from smoking"
          ]
        },
        {
          "index": 8,
          "start": 30.6,
          "end": 38.0,
          "relative_start": 30.6,
          "relative_end": 38.0,
          "en": "But as Zurich Airport, the country's largest, they can choose from 16 smoking areas, all of them indoors.",
          "zh": "但在该国最大的苏黎世机场，他们可以选择16个吸烟区，全部在室内。",
          "zh_highlights": [
            "苏黎世机场",
            "吸烟区"
          ],
          "en_highlights": [
            "Zurich Airport",
            "smoking areas"
          ]
        },
        {
          "index": 9,
          "start": 38.0,
          "end": 43.6,
          "relative_start": 38.0,
          "relative_end": 43.6,
          "en": "For years, airports have pointed to passenger demand as the reason smoking areas still exist.",
          "zh": "多年来，机场一直以乘客需求为由保留吸烟区。",
          "zh_highlights": [
            "乘客需求"
          ],
          "en_highlights": [
            "passenger demand"
          ]
        },
        {
          "index": 10,
          "start": 43.6,
          "end": 50.4,
          "relative_start": 43.6,
          "relative_end": 50.4,
          "en": "But anti-smoking groups say that airport smoking room is evidence of the lingering influence of the tobacco industry.",
          "zh": "但反吸烟组织表示，机场吸烟室证明了烟草业的持续影响。",
          "zh_highlights": [
            "烟草业",
            "持续影响"
          ],
          "en_highlights": [
            "tobacco industry",
            "lingering influence"
          ]
        },
        {
          "index": 11,
          "start": 50.4,
          "end": 59.6,
          "relative_start": 50.4,
          "relative_end": 59.6,
          "en": "Japan, tobacco international, which operates the camel, subrani and Winston brands outside of the US, says it has approximately 70 lounges around the world",
          "zh": "日本烟草国际公司在美国以外销售骆驼、苏布拉尼和云斯顿品牌，称其在全球拥有约70间休息室",
          "zh_highlights": [
            "日本烟草国际公司",
            "70间休息室"
          ],
          "en_highlights": [
            "Japan, tobacco international",
            "70 lounges"
          ]
        },
        {
          "index": 12,
          "start": 59.6,
          "end": 63.6,
          "relative_start": 59.6,
          "relative_end": 63.6,
          "en": "for smoking, vaping, and its heated tobacco products.",
          "zh": "用于吸烟、电子烟和加热烟草产品",
          "zh_highlights": [
            "吸烟",
            "电子烟"
          ],
          "en_highlights": [
            "smoking",
            "vaping"
          ]
        },
        {
          "index": 13,
          "start": 63.6,
          "end": 73.2,
          "relative_start": 63.6,
          "relative_end": 73.2,
          "en": "Doctors argue there is no justification for airport smoking rooms, especially now that smokers can rely on nicotine patches, or gum, while travelling.",
          "zh": "医生认为机场吸烟室没有存在的理由，尤其是现在旅客可以使用尼古丁贴片或口香糖",
          "zh_highlights": [
            "机场吸烟室",
            "尼古丁贴片"
          ],
          "en_highlights": [
            "airport smoking rooms",
            "nicotine patches"
          ]
        },
        {
          "index": 14,
          "start": 73.2,
          "end": 80.8,
          "relative_start": 73.2,
          "relative_end": 80.8,
          "en": "But alternative nicotine products, especially vapes, threaten to bolster demand for airport smoking rooms instead of eliminating it.",
          "zh": "但替代尼古丁产品，尤其是电子烟，反而可能增加对机场吸烟室的需求，而非消除它",
          "zh_highlights": [
            "替代尼古丁产品",
            "电子烟"
          ],
          "en_highlights": [
            "alternative nicotine products",
            "vapes"
          ]
        },
        {
          "index": 15,
          "start": 81.0,
          "end": 83.6,
          "relative_start": 81.0,
          "relative_end": 83.6,
          "en": "Zurich has two dedicated vaping rooms.",
          "zh": "苏黎世设有两间专用电子烟室",
          "zh_highlights": [
            "苏黎世",
