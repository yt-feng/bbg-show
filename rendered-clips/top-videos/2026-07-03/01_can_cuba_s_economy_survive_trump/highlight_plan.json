          "start": 72.88,
          "end": 76.38,
          "relative_start": 72.88,
          "relative_end": 76.38,
          "en": "We have an unprecedented degree of suffering on the island.",
          "zh": "岛上正遭受前所未有的苦难。",
          "zh_highlights": [
            "前所未有的苦难"
          ],
          "en_highlights": [
