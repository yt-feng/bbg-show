          "start": 23.28,
          "end": 31.44,
          "relative_start": 23.28,
          "relative_end": 31.44,
          "en": "Let's talk about the folks who really matter in the FIFA World Cup.",
          "zh": "我们来聊聊世界杯上真正重要的人。",
          "zh_highlights": [
            "真正重要的人"
          ],
          "en_highlights": [
