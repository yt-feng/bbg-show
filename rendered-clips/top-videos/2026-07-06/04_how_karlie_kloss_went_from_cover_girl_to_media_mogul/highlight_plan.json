          "en_highlights": [
            "fight for people's attention"
          ]
        },
        {
          "index": 5,
          "start": 23.38,
          "end": 26.88,
          "relative_start": 23.38,
          "relative_end": 26.88,
          "en": "What can we make that will actually break through and matter?",
          "zh": "我们能做出什么真正突破并产生影响的东西？",
          "zh_highlights": [
